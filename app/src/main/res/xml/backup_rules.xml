<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup for devices below API 31.
     Only the app's own data is worth restoring: search history, bookmarks and settings.
     The WebView's cookies and cache are deliberately left out. -->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <!-- Kept so a backup taken from version 3.0 still carries its history into the
         one-time migration in LibraryRepository. -->
    <include domain="sharedpref" path="search_prefs.xml" />
</full-backup-content>
