<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for API 31+. See backup_rules.xml for the rationale. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="search_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="search_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
